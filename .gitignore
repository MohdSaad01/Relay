logs/
*.log

# ==============================================================================
# Android / React Native (android/)
# ==============================================================================
# Gradle / native build intermediates
android/**/.gradle/
android/**/.cxx/
android/**/.kotlin/
android/**/local.properties
android/**/captures/
android/**/*.hprof

# Metro / RN tooling
.metro-health-check*
android/**/*.jsbundle

# Packaged app artifacts (the RN-convention debug keystore is not a secret
# and is deliberately kept — see docs/12_Packaging_Deployment.md)
*.apk
*.aab
*.keystore
*.jks
!android/**/debug.keystore

