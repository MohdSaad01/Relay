# Release signing credentials for the Android app (Milestone P40).
#
# Copy this file to "keystore.properties" in this same directory
# (android/android/keystore.properties) and fill in real values.
# keystore.properties is gitignored — NEVER commit it, and never commit the
# keystore file it points at. This mirrors the existing
# backend/.env.example -> backend/.env pattern used elsewhere in the repo.
#
# RELAY_RELEASE_STORE_FILE is resolved relative to this directory
# (android/android/), so a keystore placed alongside this file can be
# referenced by its bare name.
#
# Generate a real production release keystore once, keep it somewhere safe
# outside the repository (a password manager / secure backup — losing it
# means you can never publish an update under the same signing identity):
#
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore relay-release.keystore \
#     -alias relay-release \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then either:
#   - fill in the four values below and keep this file as
#     android/android/keystore.properties, or
#   - skip this file entirely and set the equivalent
#     RELAY_RELEASE_STORE_FILE / RELAY_RELEASE_STORE_PASSWORD /
#     RELAY_RELEASE_KEY_ALIAS / RELAY_RELEASE_KEY_PASSWORD environment
#     variables before running a release Gradle task (e.g. in CI).
#
# RELAY_RELEASE_STORE_FILE=relay-release.keystore
# RELAY_RELEASE_STORE_PASSWORD=changeit
# RELAY_RELEASE_KEY_ALIAS=relay-release
# RELAY_RELEASE_KEY_PASSWORD=changeit
